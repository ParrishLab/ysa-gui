[flake8]
max-line-length = 100
extend-ignore =
    E203,  # whitespace before ':'
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator
    F401,  # imported but unused (in __init__.py files)
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    .eggs,
    *.egg,
    htmlcov,
    .coverage,
    .pytest_cache,
    typings/
per-file-ignores =
    __init__.py:F401
    */conftest.py:F401,F811
    tests/*:F811